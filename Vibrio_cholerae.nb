Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "dna_", "]"}], ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", "=", 
       RowBox[{"{", "0", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"vals", ",", 
         RowBox[{
          RowBox[{"vals", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "+", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "===", "\"\<A\>\""}], "||", 
             RowBox[{"#", "===", "\"\<T\>\""}]}], ",", "0", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#", "===", "\"\<G\>\""}], ",", "1", ",", 
              RowBox[{"-", "1"}]}], "]"}]}], "]"}]}]}], "]"}], "&"}], "/@", 
      RowBox[{"StringSplit", "[", 
       RowBox[{"dna", ",", "\"\<\>\""}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",

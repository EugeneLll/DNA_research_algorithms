Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FrequentWords", "[", 
    RowBox[{"Text_", ",", "len_"}], "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"max", ",", 
       RowBox[{"words", "=", 
        RowBox[{"Counts", "@", 
         RowBox[{"StringPartition", "[", 
          RowBox[{"Text", ",", "len", ",", "1"}], "]"}]}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"max", "=", 
       RowBox[{"Max", "@", "words"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{"words", ",", 
        RowBox[{
         RowBox[{"#", "==", "max"}], "&"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.956297613993822*^9, 3.956297659005087*^9}},
